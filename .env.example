# LLM Configuration
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=

# Database
DATABASE_URL=sqlite:///./plugent.db

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Optional: Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Optional: MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=plugent

# Server
HOST=0.0.0.0
PORT=8000